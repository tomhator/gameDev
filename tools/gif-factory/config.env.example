# gif-factory 설정. 이 파일을 config.env 로 복사해서 채운다. (config.env 는 git 에 안 올라감)
# 경로에 ~ 를 써도 된다.

# 구글 드라이브(데스크톱) 안의 폴더. 맥에서 실제 경로는 보통:
#   ~/Library/CloudStorage/GoogleDrive-<구글계정>/My Drive/gameDev-gif
GIF_INBOX=~/Library/CloudStorage/GoogleDrive-you@gmail.com/My Drive/gameDev-gif/inbox
GIF_OUTBOX=~/Library/CloudStorage/GoogleDrive-you@gmail.com/My Drive/gameDev-gif/outbox

# 결과 요약을 댓글로 남길 티켓 (gh CLI 가 있을 때만). 비우면 댓글 생략.
GIF_ISSUE=18
GIF_REPO=tomhator/gameDev

# 클립 길이(초), 후보 수, 최종 선정 수
GIF_CLIP_LEN=6
GIF_CANDIDATES=8
GIF_PICKS=3

# GIF 가로 크기(쉼표), 프레임레이트, 확대 방식(픽셀아트=neighbor, 일반=lanczos)
GIF_WIDTHS=480,320
GIF_FPS=15
GIF_SCALE=neighbor

# 1 이면 claude 선정을 건너뛰고 움직임 점수만 쓴다
GIF_NO_CLAUDE=0
